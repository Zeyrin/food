{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true
  },
  // `scripts` et les tests sont du code comme le reste : les laisser hors
  // du typecheck, c'était découvrir une faute de frappe à l'exécution —
  // tsx retire les types sans jamais les vérifier.
  "include": ["src", "scripts"]
}
