{
  "name": "fffood",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview --host",
    "test": "tsx --test 'src/**/*.test.ts'",
    "lint:recipes": "node scripts/lint-recipes.mjs",
    "verifier": "tsx scripts/verifier-invariants.ts",
    "typecheck": "tsc --noEmit",
    "ci": "npm run typecheck && npm test && npm run lint:recipes && npm run verifier && npm run build",
    "mobile": "npm run build && cap sync",
    "mobile:android": "npm run mobile && cap open android",
    "mobile:ios": "npm run mobile && cap open ios",
    "mobile:assets": "node scripts/rasteriser-assets.mjs && capacitor-assets generate --iconBackgroundColor \"#141414\" --iconBackgroundColorDark \"#141414\" --splashBackgroundColor \"#fff8ef\" --splashBackgroundColorDark \"#16150f\" --android --ios"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "^2.45.0",
    "idb-keyval": "^6.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.1"
  }
}
